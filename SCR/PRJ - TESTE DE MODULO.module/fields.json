[
  {
    "id": "grupo_imagens",
    "name": "grupo_imagens",
    "label": "Imagens (mosaico)",
    "type": "group",
    "expanded": true,
    "children": [
      {
        "id": "imagem1",
        "name": "imagem1",
        "label": "Imagem 1 (grande, sem efeito)",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "default": { "src": "", "alt": "" }
      },
      {
        "id": "canto_shape1",
        "name": "canto_shape1",
        "label": "Canto menor — shape 1",
        "type": "choice",
        "display": "select",
        "choices": [["bl", "Inferior esquerdo"], ["tl", "Superior esquerdo"], ["tr", "Superior direito"], ["br", "Inferior direito"]],
        "default": "bl"
      },
      {
        "id": "imagem2",
        "name": "imagem2",
        "label": "Imagem 2 (quadrada, efeito vermelho)",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "default": { "src": "", "alt": "" }
      },
      {
        "id": "opacidade_efeito2",
        "name": "opacidade_efeito2",
        "label": "Opacidade do efeito (vermelho #D71C37)",
        "type": "number",
        "display": "slider",
        "min": 0,
        "max": 100,
        "step": 1,
        "suffix": "%",
        "default": 55
      },
      {
        "id": "canto_shape2",
        "name": "canto_shape2",
        "label": "Canto menor — shape 2",
        "type": "choice",
        "display": "select",
        "choices": [["bl", "Inferior esquerdo"], ["tl", "Superior esquerdo"], ["tr", "Superior direito"], ["br", "Inferior direito"]],
        "default": "bl"
      },
      {
        "id": "imagem3",
        "name": "imagem3",
        "label": "Imagem 3 (comprida, efeito de cor)",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "default": { "src": "", "alt": "" }
      },
      {
        "id": "cor_efeito3",
        "name": "cor_efeito3",
        "label": "Cor do efeito da imagem 3",
        "type": "color",
        "default": { "color": "#F0AD42", "opacity": 100 }
      },
      {
        "id": "opacidade_efeito3",
        "name": "opacidade_efeito3",
        "label": "Opacidade do efeito da imagem 3",
        "type": "number",
        "display": "slider",
        "min": 0,
        "max": 100,
        "step": 1,
        "suffix": "%",
        "default": 60
      },
      {
        "id": "canto_shape3",
        "name": "canto_shape3",
        "label": "Canto menor — shape 3",
        "type": "choice",
        "display": "select",
        "choices": [["bl", "Inferior esquerdo"], ["tl", "Superior esquerdo"], ["tr", "Superior direito"], ["br", "Inferior direito"]],
        "default": "bl"
      },
      {
        "id": "arredondamento",
        "name": "arredondamento",
        "label": "Arredondamento base das imagens (px)",
        "help_text": "Proporção IPOG: 3 cantos = valor total, 1 canto = valor ÷ 3.",
        "type": "number",
        "display": "slider",
        "min": 0,
        "max": 60,
        "step": 1,
        "suffix": "px",
        "default": 34
      }
    ]
  },
  {
